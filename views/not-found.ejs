<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page-shell">
    <main>
      <section class="gallery-hero reveal">
        <div class="page-links">
          <a href="/">Home</a>
          <a href="/#portfolio">Portfolio</a>
          <a href="/#contact">Contact</a>
        </div>
        <p class="section-kicker">404</p>
        <h1>Halaman tidak ditemukan</h1>
        <p>Halaman yang Anda cari tidak tersedia atau sudah dipindahkan.</p>
      </section>
    </main>
  </div>
  <script>
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('show'));
  </script>
</body>

</html>
