# ---------------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilainya.
# Cara termudah: jalankan `npm run setup` (membuat .env otomatis + password acak).
# ---------------------------------------------------------------------------

# Port server
PORT=3000

# Wajib diisi: dipakai untuk menandatangani cookie session.
# Buat nilai acak dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Kredensial admin
ADMIN_USER=admin

# Hash bcrypt dari password admin (JANGAN tulis password asli di sini).
# Buat hash dengan: npm run hash
ADMIN_PASSWORD_HASH=$2a$12$ganti.dengan.hash.bcrypt.yang.asli

# Set ke "true" bila website sudah di belakang HTTPS (mis. di VPS + Nginx/Cloudflare).
# Saat true, cookie session hanya dikirim lewat HTTPS.
SECURE_COOKIE=false

# Nama tampilan admin yang muncul di dashboard (opsional).
ADMIN_DISPLAY_NAME=Administrator
