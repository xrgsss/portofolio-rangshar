# ---------------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilainya.
# Cara termudah: jalankan `npm run setup` (membuat .env otomatis + password acak).
#
# Catatan: di Vercel file .env TIDAK dipakai. Semua nilai di bawah diisi
# sebagai Environment Variable di dashboard Vercel. Kredensial Redis & Blob
# ditambahkan otomatis saat kamu menghubungkan store ke project.
#
# PENTING: variabel bertipe Secret di Vercel tidak bisa dibaca ulang, jadi
# `vercel env pull` menulis "[SENSITIVE]" sebagai gantinya. Nilai itu otomatis
# dibuang oleh aplikasi. Untuk menjalankan skrip migrasi dari laptop, salin
# REDIS_URL dari dashboard lalu tulis manual di file .env ini.
# ---------------------------------------------------------------------------

# Port server (lokal saja)
PORT=3000

# Wajib diisi: dipakai untuk menandatangani cookie session.
# Buat nilai acak dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Kredensial admin
ADMIN_USER=admin

# Hash bcrypt dari password admin (JANGAN tulis password asli di sini).
# Buat hash dengan: npm run hash
ADMIN_PASSWORD_HASH=$2a$12$ganti.dengan.hash.bcrypt.yang.asli

# Set ke "true" bila website dilayani lewat HTTPS.
# (Di Vercel nilainya dianggap true secara otomatis.)
SECURE_COOKIE=false

# Penguncian login setelah beberapa kali gagal.
# DEFAULT MATI. Isi "on" kalau ingin diaktifkan kembali
# (5 percobaan gagal per 15 menit -> dikunci 15 menit).
LOGIN_RATE_LIMIT=off

# Nama tampilan admin yang muncul di dashboard (opsional).
ADMIN_DISPLAY_NAME=Administrator

# ---------------------------------------------------------------------------
# Penyimpanan (di Vercel ditambahkan otomatis oleh integrasi, jangan diisi manual)
# ---------------------------------------------------------------------------

# Redis untuk data website + rate limit login. Salah satu bentuk ini cukup:
#   a. KV_REST_API_URL + KV_REST_API_TOKEN          (atau UPSTASH_REDIS_REST_*)
#   b. REDIS_URL                                    (redis:// atau rediss://)
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx
# REDIS_URL=rediss://default:xxxxxxxx@xxxx.upstash.io:6379

# Vercel Blob untuk semua gambar & video.
# BLOB_STORE_ID=store_xxxxxxxx
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
