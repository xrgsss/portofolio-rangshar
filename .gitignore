node_modules/
.env
.env.local
.env.*.local
!.env.example

# Runtime session files (hanya dipakai versi lama)
.sessions/

# Statistik pengunjung versi lokal; di Vercel angkanya tersimpan di Redis.
data/analytics.json

# Media lokal. Setelah `npm run migrate:media`, semua berkas ini sudah berada
# di Vercel Blob dan tidak perlu ikut ke Git lagi.
images/

# Konfigurasi Vercel lokal
.vercel/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.log
npm-debug.log*

# Ditaruh paling bawah dengan sengaja: Vercel CLI menambahkan baris ".env*"
# setiap kali `vercel env pull` dijalankan, dan pola terakhir yang menang.
# Baris ini memastikan berkas contoh tetap ikut ter-commit.
!.env.example
.env*
